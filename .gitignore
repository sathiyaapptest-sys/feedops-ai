# Secrets
.env
.env.*
!.env.example

# Proprietary domain knowledge -- kept local and baked into the deployed
# Docker image (see .gcloudignore + Dockerfile), never in version control.
# backend/rag/playbook_index.py chunks/embeds this file into an in-memory
# index at runtime, so excluding it from git does not affect the running app.
GOOGLE_ORDERING_REDIRECT_PLAYBOOK.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/

# OS
.DS_Store

# Build / runtime output
feeds_output/
*.log

# Anything for internal use only (working notes, video-production assets,
# scratch files) goes in here -- never in version control, no matter what
# gets added to it later. docs/ stays public and holds only what's actually
# referenced from the README.
internals/
