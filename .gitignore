# Secrets
.env
.env.*
!.env.example

# Proprietary domain knowledge -- kept local and baked into the deployed
# Docker image (see .gcloudignore + Dockerfile), never in version control.
# backend/rag/playbook_index.py chunks/embeds this file into an in-memory
# index at runtime, so excluding it from git does not affect the running app.
GOOGLE_ORDERING_REDIRECT_PLAYBOOK.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/

# OS
.DS_Store

# Build / runtime output
feeds_output/
*.log

# Internal working notes -- not for public/judge consumption
WOW_FACTORS.md
PROGRESS.md

# docs/ holds internal video-production assets (chapter cards, badges, fonts,
# raw video clips, credits page) alongside the one architecture diagram that's
# actually referenced from the README. Ignore everything in docs/ except that
# one file, rather than the other way around, so a new internal asset dropped
# in here later doesn't need a matching .gitignore update to stay private.
docs/*
!docs/architecture-diagram 1.svg
