rules_version = '2';

// Scope: the three collections the frontend's Firebase client SDK touches
// directly (stores, menus, users) -- see frontend/src/components/**.
//
// Everything else (merchants, organizations, upload_batches, playbook_chunks)
// is backend-only, written via the Firebase Admin SDK with a service account,
// which bypasses these rules entirely. They're explicitly denied here anyway
// as defense in depth, since nothing legitimate ever reads/writes them from
// a browser.
service cloud.firestore {
  match /databases/{database}/documents {

    // Merchant self-service storefront profile (MyStore.tsx) + public
    // customer-facing storefront view (StoreView.tsx). Doc ID is the
    // merchant's own email.
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == storeId;
    }

    // Merchant menu (Menu.tsx) + public customer-facing menu view
    // (StoreView.tsx). Doc ID is the merchant's email, falling back to uid.
    match /menus/{storeId} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.email == storeId || request.auth.uid == storeId);
    }

    // Role lookup (Login.tsx) -- read-only from the client. No client write
    // path exists in the app; role assignment is an admin/backend concern.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
