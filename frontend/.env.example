# Firebase Web SDK config for a real Firebase project (console.firebase.google.com).
# Without these, firebase.ts falls back to dummy values and every auth-gated
# feature (onboarding, MyStore save, triage actions) silently fails to sign in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
